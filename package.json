{
  "name": "@kuriyona/cecilia",
  "version": "2.0.0-beta.1",
  "description": "网易云音乐 API 的非官方 TypeScript 封装",
  "keywords": [
    "api",
    "music",
    "netease",
    "typescript"
  ],
  "homepage": "https://github.com/Kuriyona/Cecilia",
  "bugs": {
    "url": "https://github.com/Kuriyona/Cecilia/issues"
  },
  "license": "MIT",
  "author": "Kuriyona <kuriyona@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kuriyona/Cecilia.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./elysia": {
      "import": {
        "types": "./dist/elysia.d.mts",
        "default": "./dist/elysia.mjs"
      },
      "require": {
        "types": "./dist/elysia.d.cts",
        "default": "./dist/elysia.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clone:api-enhanced": "node -e \"require('node:fs').rmSync('api-enhanced',{recursive:true,force:true})\" && git clone --depth=1 git@github.com:NeteaseCloudMusicApiEnhanced/api-enhanced.git",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@elysiajs/cors": "^1.4.2",
    "elysia": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "@elysiajs/cors": {
      "optional": true
    },
    "elysia": {
      "optional": true
    }
  },
  "devDependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "elysia": "^1.4.30",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.4.0",
      "onFail": "download"
    }
  },
  "email": "kuriyona@outlook.com"
}
